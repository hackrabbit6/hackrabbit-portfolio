---
import './HeroCanvas.css'
---

{/* 东方水墨实时 3D 背景（ADR 0003）。无 WebGL / JS 时退回 .ink-fallback 静态画面。 */}
<div class="ink-scene" data-ink-scene aria-hidden="true">
  {/*
    月盘 + 3–4 层水墨远山（CanvasTexture，七级模糊做墨晕）+ 浮雾粒子。
    只在 Hero 可见时渲染；指针视差只改相机，不碰滚动。
  */}
  <div class="ink-fallback"></div>
  <canvas class="hero-canvas" data-ink-canvas></canvas>
</div>

<script>
  import * as THREE from 'three'

  const root = document.querySelector<HTMLElement>('[data-ink-scene]')
  const canvas = document.querySelector<HTMLCanvasElement>('[data-ink-canvas]')

  const webglAvailable = () => {
    try {
      const probe = document.createElement('canvas')
      return Boolean(
        window.WebGLRenderingContext && (probe.getContext('webgl2') || probe.getContext('webgl')),
      )
    } catch {
      return false
    }
  }

  if (root && canvas && webglAvailable()) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const coarse = window.matchMedia('(pointer: coarse)').matches
    const PAPER = 0xede4d3

    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
      powerPreference: 'low-power',
    })
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.5))

    const scene = new THREE.Scene()
    const camera = new THREE.PerspectiveCamera(42, 1, 0.1, 300)
    camera.position.set(0, 1.6, 30)

    const seed = (n: number) => () => {
      n |= 0
      n = (n + 0x6d2b79f5) | 0
      let t = Math.imul(n ^ (n >>> 15), 1 | n)
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296
    }

    const glowTexture = () => {
      const size = 512
      const c = document.createElement('canvas')
      c.width = c.height = size
      const ctx = c.getContext('2d')!
      const g = ctx.createRadialGradient(size / 2, size / 2, 0, size / 2, size / 2, size / 2)
      g.addColorStop(0, 'rgba(237,228,211,0.95)')
      g.addColorStop(0.1, 'rgba(237,228,211,0.6)')
      g.addColorStop(0.34, 'rgba(214,74,50,0.16)')
      g.addColorStop(1, 'rgba(214,74,50,0)')
      ctx.fillStyle = g
      ctx.fillRect(0, 0, size, size)
      return new THREE.CanvasTexture(c)
    }

    const moon = new THREE.Sprite(
      new THREE.SpriteMaterial({ map: glowTexture(), transparent: true, depthWrite: false }),
    )
    moon.scale.set(34, 34, 1)
    moon.position.set(14, 10, -24)
    scene.add(moon)

    // 地平线月霭：一条被拉长的柔光，让远山有可剪影的亮底。
    const hazeTexture = () => {
      const size = 256
      const c = document.createElement('canvas')
      c.width = size
      c.height = size
      const ctx = c.getContext('2d')!
      const g = ctx.createRadialGradient(size / 2, size / 2, 0, size / 2, size / 2, size / 2)
      g.addColorStop(0, 'rgba(214,74,50,0.22)')
      g.addColorStop(0.45, 'rgba(214,74,50,0.08)')
      g.addColorStop(1, 'rgba(214,74,50,0)')
      ctx.fillStyle = g
      ctx.fillRect(0, 0, size, size)
      return new THREE.CanvasTexture(c)
    }
    const haze = new THREE.Sprite(
      new THREE.SpriteMaterial({ map: hazeTexture(), transparent: true, depthWrite: false, opacity: 0.5 }),
    )
    haze.scale.set(150, 28, 1)
    haze.position.set(0, -3, -30)
    scene.add(haze)

    const mountainTexture = (top: string, bottom: string, s: number) => {
      const w = 1024
      const h = 512
      const c = document.createElement('canvas')
      c.width = w
      c.height = h
      const ctx = c.getContext('2d')!
      const rnd = seed(s)
      ctx.filter = 'blur(7px)'
      const g = ctx.createLinearGradient(0, 0, 0, h)
      g.addColorStop(0, top)
      g.addColorStop(1, bottom)
      ctx.fillStyle = g
      ctx.beginPath()
      ctx.moveTo(-20, h + 20)
      let x = -20
      let y = h * 0.7
      ctx.lineTo(-20, y)
      while (x < w + 60) {
        x += 60 + rnd() * 130
        y = h * 0.42 + rnd() * h * 0.42
        ctx.lineTo(x, y)
      }
      ctx.lineTo(w + 20, h * 0.72)
      ctx.lineTo(w + 20, h + 20)
      ctx.closePath()
      ctx.fill()
      const tex = new THREE.CanvasTexture(c)
      tex.colorSpace = THREE.SRGBColorSpace
      return tex
    }

    const layers = [
      { z: -26, y: -4.0, w: 100, h: 30, top: 'rgba(150,166,152,0.2)', bottom: 'rgba(150,166,152,0.02)', s: 11 },
      { z: -17, y: -4.8, w: 92, h: 27, top: 'rgba(160,136,104,0.34)', bottom: 'rgba(160,136,104,0.03)', s: 29 },
      { z: -9, y: -5.6, w: 84, h: 24, top: 'rgba(140,116,88,0.55)', bottom: 'rgba(140,116,88,0.05)', s: 47 },
    ]
    const mountains: THREE.Mesh[] = []
    for (const layer of layers) {
      const mesh = new THREE.Mesh(
        new THREE.PlaneGeometry(layer.w, layer.h),
        new THREE.MeshBasicMaterial({
          map: mountainTexture(layer.top, layer.bottom, layer.s),
          transparent: true,
          depthWrite: false,
        }),
      )
      mesh.position.set(0, layer.y, layer.z)
      scene.add(mesh)
      mountains.push(mesh)
    }

    const dotTexture = () => {
      const size = 64
      const c = document.createElement('canvas')
      c.width = c.height = size
      const ctx = c.getContext('2d')!
      const g = ctx.createRadialGradient(size / 2, size / 2, 0, size / 2, size / 2, size / 2)
      g.addColorStop(0, 'rgba(237,228,211,0.9)')
      g.addColorStop(1, 'rgba(237,228,211,0)')
      ctx.fillStyle = g
      ctx.fillRect(0, 0, size, size)
      return new THREE.CanvasTexture(c)
    }

    const count = coarse ? 40 : 70
    const positions = new Float32Array(count * 3)
    const speeds = new Float32Array(count)
    for (let i = 0; i < count; i += 1) {
      positions[i * 3] = (Math.random() - 0.5) * 92
      positions[i * 3 + 1] = -12 + Math.random() * 18
      positions[i * 3 + 2] = -6 - Math.random() * 26
      speeds[i] = 0.4 + Math.random() * 0.9
    }
    const mistGeometry = new THREE.BufferGeometry()
    mistGeometry.setAttribute('position', new THREE.BufferAttribute(positions, 3))
    const mist = new THREE.Points(
      mistGeometry,
      new THREE.PointsMaterial({
        map: dotTexture(),
        size: 4,
        color: PAPER,
        transparent: true,
        opacity: 0.09,
        depthWrite: false,
        sizeAttenuation: true,
      }),
    )
    scene.add(mist)

    const resize = () => {
      const w = root.clientWidth || window.innerWidth
      const h = root.clientHeight || window.innerHeight
      renderer.setSize(w, h, false)
      camera.aspect = w / h
      camera.updateProjectionMatrix()
      scene.background = null
      renderer.render(scene, camera)
    }

    const pointer = { x: 0, y: 0 }
    const target = { x: 0, y: 0 }
    if (!reduceMotion && !coarse) {
      window.addEventListener(
        'pointermove',
        (event) => {
          target.x = (event.clientX / window.innerWidth) * 2 - 1
          target.y = (event.clientY / window.innerHeight) * 2 - 1
        },
        { passive: true },
      )
    }

    let visible = true
    const observer = new IntersectionObserver(
      (entries) => {
        visible = entries[0]?.isIntersecting ?? true
      },
      { threshold: 0 },
    )
    observer.observe(root)

    const mistAttribute = mistGeometry.getAttribute('position') as THREE.BufferAttribute
    let time = 0
    const update = () => {
      time += 0.0016
      pointer.x += (target.x - pointer.x) * 0.045
      pointer.y += (target.y - pointer.y) * 0.045
      camera.position.x = pointer.x * 2.6
      camera.position.y = 1.6 - pointer.y * 1.8
      camera.lookAt(0, 0, -10)

      for (let i = 0; i < count; i += 1) {
        let x = mistAttribute.getX(i) - speeds[i] * 0.02
        if (x < -46) x = 46
        mistAttribute.setX(i, x)
        mistAttribute.setY(i, mistAttribute.getY(i) + Math.sin(time + i) * 0.002)
      }
      mistAttribute.needsUpdate = true
      mist.rotation.z = Math.sin(time * 0.6) * 0.02
      ;(moon.material as THREE.SpriteMaterial).opacity = 0.9 + Math.sin(time * 1.3) * 0.06
    }

    let frame = 0
    const loop = () => {
      frame = requestAnimationFrame(loop)
      if (!visible) return
      update()
      renderer.render(scene, camera)
    }

    root.setAttribute('data-webgl', 'on')
    resize()
    window.addEventListener('resize', resize, { passive: true })
    if (reduceMotion) {
      renderer.render(scene, camera)
    } else {
      loop()
    }

    document.addEventListener(
      'astro:before-swap',
      () => {
        cancelAnimationFrame(frame)
        observer.disconnect()
        window.removeEventListener('resize', resize)
        for (const mesh of mountains) {
          const material = mesh.material as THREE.MeshBasicMaterial
          material.map?.dispose()
          material.dispose()
          mesh.geometry.dispose()
        }
        for (const sprite of [moon, haze]) {
          const material = sprite.material as THREE.SpriteMaterial
          material.map?.dispose()
          material.dispose()
        }
        renderer.dispose()
      },
      { once: true },
    )
  } else {
    canvas?.remove()
  }
</script>
