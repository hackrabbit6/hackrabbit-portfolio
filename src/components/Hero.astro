---
import './Hero.css'
import './HackRabbitMark.css'
import HeroField from './HeroField.astro'
---

<section class="hero-act static" id="top">
  <HeroField />
  <nav class="site-nav" aria-label="主导航">
    <a class="brand" href="#top">
      <span>hackrabbit</span>
      <small>frontend operator</small>
    </a>
    <div>
      <a href="#crew">AI Crew</a>
      <a href="#work">作品</a>
      <a href="#skills">能力</a>
      <a href="#experience">经历</a>
      <a href="/work/">案例</a>
      <a href="#contact">联系</a>
    </div>
  </nav>
  <div class="hero-inner">
    <div class="hero-copy">
      <p class="eyebrow hero-reveal">frontend operator / hackrabbit</p>
      <h1 class="hero-title hero-reveal">HACKRABBIT</h1>
      <p class="lead hero-reveal">
        4-5 年前端交付。我用第一性原理拆问题，带着 <span class="nowrap">AI crew</span> 把活干得更快更稳。
      </p>
      <div class="hero-cta hero-reveal">
        <a class="cta cta-primary" href="#work">Selected Work ↓</a>
        <a class="cta" href="https://github.com/hackrabbit6" target="_blank" rel="noreferrer">
          GitHub ↗
        </a>
      </div>
    </div>
    <div class="hero-mark hero-reveal">
      <pre class="hackrabbit-mark" role="img" aria-label="hackrabbit 的 ASCII 兔子标记">(\(\
(•ᴥ•)
/ づ</pre>
    </div>
  </div>
</section>
