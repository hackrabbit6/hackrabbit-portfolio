---
import './Follow.css'
import { writingCount, latestDate } from '../lib/writing'
import { MapMark } from './MapMark'

// 两个平台是同一个身份，简介也相同，所以简介提到区块级别，卡片里只区分「形式」。
// 公众号在微信生态里没有可点击的公开主页，只能放二维码或让人搜账号名 —— 这是平台限制，
// 不是没做完；不要为了「两边对称」而伪造一个跳转链接。
const accounts = [
  {
    platform: '公众号',
    format: '长文',
    qr: '/wechat-qr.jpg',
    hint: '微信扫码，或搜「黑兔实验室」',
  },
  {
    platform: '小红书',
    format: '图文笔记',
    href: 'https://www.xiaohongshu.com/user/profile/5cd9477800000000160116e4',
    hint: '打开主页',
  },
]
---

<section class="follow" id="follow" data-map-stop="lab">
  <div class="follow-head">
    <MapMark stop="lab" />
    <h2>黑兔实验室</h2>
    <p class="follow-bio">帮普通人看懂 AI 时代里和自己有关的变化。</p>
    {/* 内容维度的活跃证据：篇数与最新一篇的发布日期，都取自 src/lib/writing.ts。
        招聘方与内容读者都能据此判断「这个号还在写」。 */}
    <p class="follow-updated">
      {writingCount} 篇长文{latestDate ? ` · 最近更新 ${latestDate}` : ''}
    </p>
  </div>

  <ul class="follow-list">
    {
      accounts.map((a) => (
        <li class="follow-card">
          <p class="follow-platform">
            {a.platform}
            <span>{a.format}</span>
          </p>
          {a.qr ? (
            <img
              class="follow-qr"
              src={a.qr}
              alt="黑兔实验室公众号二维码，用微信扫码关注"
              width="128"
              height="128"
              loading="lazy"
              decoding="async"
            />
          ) : null}
          {a.href ? (
            <a class="follow-link" href={a.href} target="_blank" rel="noreferrer">
              {a.hint} →
            </a>
          ) : (
            <p class="follow-hint">{a.hint}</p>
          )}
        </li>
      ))
    }
  </ul>

  <a class="follow-more" href="/writing/">看我写过什么 →</a>
</section>
