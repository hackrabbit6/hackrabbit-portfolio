---
import './NightMap.css'
import type { StopKey } from '../lib/night-map'
import { STOP_META } from '../lib/map-stops'

// 全站共用的夜间地图（ADR 0004 / NIGHT-MAP.md）。
// 首页：读到哪个带 data-map-stop 的区块，镜头就飞到哪个地标；
// 子页面：停在 stop 指定的地标，随滚动绕行。
type Props = { stop?: StopKey }
const { stop = 'start' } = Astro.props

// 地标名与方位只有一份定义（src/lib/map-stops.ts），图例与区块标注都读它。
const names = Object.fromEntries(
  Object.entries(STOP_META).map(([key, meta]) => [key, meta.name]),
) as Record<StopKey, string>
const legend: Array<{ key: StopKey; label: string }> = [
  { key: 'start', label: '全图' },
  { key: 'workshop', label: '工坊 · 在做什么' },
  { key: 'lab', label: '实验室 · 关注' },
  { key: 'tower', label: '作品塔 · 作品' },
  { key: 'pillars', label: '四柱 · 能力' },
  { key: 'stairs', label: '台阶 · 经历' },
  { key: 'desk', label: '工作台 · AI 工具' },
  { key: 'portal', label: '传送门 · 联系' },
]
---

<div class="night-map" data-night-map data-stop={stop} data-names={JSON.stringify(names)}>
  <div class="night-fallback" aria-hidden="true"></div>
  <canvas class="night-canvas" data-night-canvas aria-hidden="true"></canvas>
  <div class="night-veil" aria-hidden="true"></div>
</div>

<nav class="map-legend" data-map-legend aria-label="地图图例" hidden>
  <span class="map-legend-title">图例 · 路线</span>
  {
    legend.map((item) => (
      <button type="button" data-go={item.key}>
        <span>{item.label}</span>
        <i aria-hidden="true" />
      </button>
    ))
  }
</nav>

<a class="map-here" data-map-here href="/" hidden>
  <span class="map-here-dot" aria-hidden="true"></span>
  <span>你在 · <strong data-map-here-name>{names[stop]}</strong></span>
  <span class="map-here-back">回到全图 →</span>
</a>

{/* 地标钉：当前地标的屏幕投影点，引线的终点。纯装饰，不拦指针。 */}
<span class="map-pin" data-map-pin data-on="0" aria-hidden="true"></span>

<div class="map-tip" data-map-tip aria-hidden="true"></div>

<script>
  import type { NightMapHandle, StopKey } from '../lib/night-map'

  const root = document.querySelector<HTMLElement>('[data-night-map]')
  const canvas = document.querySelector<HTMLCanvasElement>('[data-night-canvas]')
  const legend = document.querySelector<HTMLElement>('[data-map-legend]')
  const here = document.querySelector<HTMLElement>('[data-map-here]')
  const tip = document.querySelector<HTMLElement>('[data-map-tip]')
  const pin = document.querySelector<HTMLElement>('[data-map-pin]')

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  const coarse = window.matchMedia('(pointer: coarse)').matches

  const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-map-stop]'))
  const tour = sections.length > 0
  const pageStop = (root?.dataset.stop ?? 'start') as StopKey
  const names = JSON.parse(root?.dataset.names ?? '{}') as Record<StopKey, string>

  // 首页区块与地标一一对应；子页面点地标时跳到对应页面或首页区块。
  const sectionFor = (key: StopKey) => sections.find((s) => s.dataset.mapStop === key)
  const pageHref: Record<StopKey, string> = {
    start: '/',
    workshop: '/#building',
    lab: '/writing/',
    tower: '/work/',
    pillars: '/services/',
    stairs: '/#experience',
    desk: '/#crew',
    portal: '/#contact',
  }

  const scrollToStop = (key: StopKey) => {
    const target = sectionFor(key)
    if (target) target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' })
  }

  // 当前阅读位置：顶边越过视口 40% 的最后一个区块。
  const readingStop = (): StopKey => {
    const line = window.innerHeight * 0.4
    let key = (sections[0]?.dataset.mapStop ?? 'start') as StopKey
    for (const s of sections) {
      if (s.getBoundingClientRect().top <= line) key = s.dataset.mapStop as StopKey
    }
    return key
  }

  const markLegend = (key: StopKey) => {
    legend?.querySelectorAll<HTMLButtonElement>('button').forEach((b) => {
      if (b.dataset.go === key) b.setAttribute('aria-current', 'step')
      else b.removeAttribute('aria-current')
    })
  }

  if (tour && legend) {
    legend.hidden = false
    legend.querySelectorAll<HTMLButtonElement>('button').forEach((b) => {
      b.addEventListener('click', () => scrollToStop(b.dataset.go as StopKey))
    })
    markLegend(readingStop())
  }
  if (!tour && here && pageStop !== 'start') here.hidden = false

  // 指针在文字、链接、图片、卡片上时，地标不响应，避免误跳转、不影响选字。
  const overContent = (el: Element | null) =>
    Boolean(
      el?.closest(
        'a,button,input,textarea,select,label,summary,p,h1,h2,h3,h4,h5,li,img,picture,figure,blockquote,table,pre,code,article,time,small,strong,nav,[data-tilt]',
      ),
    )

  const webglAvailable = () => {
    try {
      const probe = document.createElement('canvas')
      return Boolean(window.WebGLRenderingContext && (probe.getContext('webgl2') || probe.getContext('webgl')))
    } catch {
      return false
    }
  }

  // 首屏标题的位置 → 夜色遮罩的开口（NIGHT-MAP.css）。
  // 只在滚动那一帧读一次布局，不和相机同步。
  const title = document.querySelector<HTMLElement>('.hero-title:not(.hero-title-ghost)')
  const syncBand = () => {
    if (!title) return
    const rect = title.getBoundingClientRect()
    const style = document.documentElement.style
    style.setProperty('--band-x', `${Math.round(rect.left + rect.width / 2)}px`)
    style.setProperty('--band-y', `${Math.round(rect.top + rect.height / 2)}px`)
    style.setProperty('--band-rx', `${Math.round(rect.width / 2 + 70)}px`)
    style.setProperty('--band-ry', `${Math.round(rect.height / 2 + 46)}px`)
  }
  if (title) {
    new ResizeObserver(syncBand).observe(title)
  }

  // 正文栏的右边界（窗口坐标）：化身的安全线与引线的拐点都读它。
  // 首页各区块用 --map-col 把右边让给地图；子页面（case-shell）正文更窄 —— 所以量，不猜 token。
  // 首屏 #top 不算：它没有这条右留白，而且标题要跨到地图上。
  const contentEdge = () => {
    if (window.innerWidth < 1100) return 0
    let edge = 0
    for (const el of document.querySelectorAll<HTMLElement>('main [data-map-stop]:not(#top), main.case-shell')) {
      const rect = el.getBoundingClientRect()
      const pad = parseFloat(getComputedStyle(el).paddingRight) || 0
      edge = Math.max(edge, rect.right - pad)
    }
    return edge
  }

  // ── 引线：区块标注 → 地标投影 ────────────────────────────────
  // 布局（标注在哪、正文栏右边界在哪）只在滚动那一帧读一次，投影每帧算（相机一直在动）。
  const wide = window.matchMedia('(min-width: 1100px)')
  const anchors = Array.from(document.querySelectorAll<HTMLElement>('[data-map-leader]')).map((el) => ({
    el,
    key: (el.closest('[data-map-stop]') as HTMLElement | null)?.dataset.mapStop as StopKey,
    x: 0,
    y: 0,
    visible: false,
  }))

  // 引线的拐点就是正文栏右边界：过了这条线才是地图，斜段不穿过任何字。
  let elbowX = 0
  let measuredWidth = 0
  const measureElbow = () => {
    if (window.innerWidth === measuredWidth) return
    measuredWidth = window.innerWidth
    elbowX = contentEdge() + 12
  }

  const syncAnchorRects = () => {
    measureElbow()
    const height = window.innerHeight
    for (const a of anchors) {
      const rect = a.el.getBoundingClientRect()
      a.x = rect.right + 10
      a.y = rect.top + rect.height / 2
      a.visible = rect.bottom > 0 && rect.top < height
    }
  }

  const setVar = (el: HTMLElement, name: string, value: string) => {
    if (el.style.getPropertyValue(name) !== value) el.style.setProperty(name, value)
  }

  const setOn = (el: HTMLElement, on: boolean) => {
    const next = on ? '1' : '0'
    if (el.dataset.on !== next) el.dataset.on = next
  }

  const boot = async (host: HTMLElement, cv: HTMLCanvasElement) => {
    const { bootNightMap } = await import('../lib/night-map')
    const map: NightMapHandle = bootNightMap(cv, {
      initial: tour ? readingStop() : pageStop,
      reduceMotion,
      coarse,
      contentRight: contentEdge,
    })
    host.dataset.webgl = 'on'

    // 当前地标：首页跟着阅读位置，子页面就停在页面地标。
    let active: StopKey = tour ? readingStop() : pageStop

    // 引线与地标钉：投影每帧算（相机一直在动），布局只在滚动那一帧读。
    const syncAnchors = () => {
      if (!wide.matches || coarse) return
      const here = map.project(active)
      if (pin) {
        if (here) {
          setVar(pin, '--stop-x', `${Math.round(here.x)}px`)
          setVar(pin, '--stop-y', `${Math.round(here.y)}px`)
        }
        setOn(pin, Boolean(here))
      }
      for (const a of anchors) {
        // 只有当前这一段亮引线：八个区块同时连线就不是标注，是一团网。
        const point = a.visible && a.key === active ? map.project(a.key) : null
        // 先水平拉到正文栏边界，再斜拉到地标（两段引线，拐点不穿过正文）。
        const run = Math.max(0, Math.min(elbowX - a.x, 640))
        const elbow = { x: a.x + run, y: a.y }
        const length = point ? Math.hypot(point.x - elbow.x, point.y - elbow.y) - 12 : 0
        if (!point || length < 20 || length > 900) {
          setVar(a.el, '--leader-opacity', '0')
          continue
        }
        setVar(a.el, '--leader-run', `${Math.round(run)}px`)
        setVar(a.el, '--leader-length', `${Math.round(length)}px`)
        setVar(a.el, '--leader-angle', `${Math.atan2(point.y - elbow.y, point.x - elbow.x)}rad`)
        setVar(a.el, '--leader-opacity', '1')
      }
    }
    map.onFrame(syncAnchors)

    let ticking = false
    const onScroll = () => {
      if (ticking) return
      ticking = true
      requestAnimationFrame(() => {
        ticking = false
        syncBand()
        syncAnchorRects()
        if (tour) {
          const key = readingStop()
          active = key
          map.setStop(key)
          markLegend(key)
        } else {
          const max = document.documentElement.scrollHeight - window.innerHeight
          map.setOrbit(max > 0 ? (window.scrollY / max) * 2 - 1 : 0)
        }
      })
    }
    window.addEventListener('scroll', onScroll, { passive: true })
    // 标注位置也会因为换行、字体重算而变，不只因为滚动。
    new ResizeObserver(syncAnchorRects).observe(document.documentElement)
    onScroll()
    syncAnchorRects()

    if (coarse) return

    let hovered: StopKey | null = null
    window.addEventListener(
      'pointermove',
      (event) => {
        const nx = (event.clientX / window.innerWidth) * 2 - 1
        const ny = -(event.clientY / window.innerHeight) * 2 + 1
        if (!reduceMotion) map.setParallax(nx * 0.5, -ny * 0.5)
        const key = overContent(event.target as Element) ? null : map.pick(nx, ny)
        if (key !== hovered) {
          hovered = key
          map.setHover(key)
          document.documentElement.classList.toggle('map-pointing', Boolean(key))
          if (tip) {
            tip.textContent = key ? `${names[key]} · 点击前往` : ''
            tip.classList.toggle('on', Boolean(key))
          }
        }
        if (tip && key) tip.style.transform = `translate(${event.clientX + 14}px, ${event.clientY + 14}px)`
      },
      { passive: true },
    )
    window.addEventListener('click', (event) => {
      if (!hovered || overContent(event.target as Element)) return
      if (window.getSelection()?.toString()) return
      if (tour && sectionFor(hovered)) scrollToStop(hovered)
      else window.location.href = pageHref[hovered]
    })
  }

  if (root && canvas && webglAvailable()) {
    const run = () => {
      boot(root, canvas).catch(() => canvas.remove())
    }
    const idle = window.requestIdleCallback?.bind(window)
    if (idle) idle(run, { timeout: 1500 })
    else window.setTimeout(run, 120)
  } else {
    canvas?.remove()
  }
</script>
