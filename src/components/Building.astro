---
import './Building.css'

// 「在做什么」是首页主角区块（见 CONTEXT.md）：只放**在造的东西**，
// 不放「在看什么、在想什么」—— 那是 /now/ 的事（决定 5）。
// 它取代了原来的 NOW · CREW 薄带，NOW 并入这里（决定 3）。
// 措辞只能来自事实：没有公开链接的就不给链接，未上线就直说在起步。
const items = [
  {
    label: '内容',
    title: '黑兔实验室',
    text: '用数据和实测，讲清 AI 时代的变化。',
    href: '/writing/',
    action: '看我写过什么',
  },
  {
    label: '工具',
    title: '私人阅读站',
    text: '书和文章丢进文件夹就有阅读页，本地运行。',
  },
  {
    label: '产品',
    title: '计费重量计算器',
    text: '帮跨境卖家算清计费重量，独立站刚起步。',
  },
  {
    label: '产品',
    title: 'App Store 小工具',
    text: '在准备一个自己上架的小工具 App。',
  },
]
---

<section class="building" id="building">
  <div class="building-head">
    <p class="eyebrow">在做什么</p>
    <h2>我在造的东西</h2>
  </div>

  <ul class="building-list">
    {
      items.map((item, i) => (
        <li class="building-card" data-tilt data-index={['壹', '贰', '叁', '肆'][i]}>
          <p class="building-label">{item.label}</p>
          <h3>{item.title}</h3>
          <p class="building-text">{item.text}</p>
          {item.href ? (
            <a class="building-link" href={item.href}>
              {item.action} →
            </a>
          ) : null}
        </li>
      ))
    }
  </ul>
</section>