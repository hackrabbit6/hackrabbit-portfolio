---
import '../styles/tokens.css'

const {
  title = 'hackrabbit · 前端工程师 / 独立开发',
  description = 'hackrabbit 的个人主页：前端工程师、独立开发。做前端交付、H5 SDK、AI 应用与独立产品，也写 AI 时代里和普通人有关的变化。',
} = Astro.props

// canonical 去掉 query，避免可分享 URL 产生重复规范页。
const canonical = new URL(Astro.url.pathname, Astro.site)
const ogImage = new URL('/og.png', Astro.site)
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0B0A08" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="hackrabbit" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="hackrabbit：帮普通人看懂 AI 时代里和自己有关的变化。" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <slot />
    <script>
      // 卡片 3D 倾斜（ORIENTAL-REDESIGN.md）。只写 CSS 变量，不动布局与滚动。
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
      const coarsePointer = window.matchMedia('(pointer: coarse)')
      if (!reduceMotion.matches && !coarsePointer.matches) {
        const MAX_DEG = 4
        const cards = document.querySelectorAll<HTMLElement>('[data-tilt]')
        cards.forEach((card) => {
          const reset = () => {
            card.style.setProperty('--rx', '0deg')
            card.style.setProperty('--ry', '0deg')
          }
          card.addEventListener('pointermove', (event) => {
            const rect = card.getBoundingClientRect()
            const px = (event.clientX - rect.left) / rect.width - 0.5
            const py = (event.clientY - rect.top) / rect.height - 0.5
            card.style.setProperty('--ry', `${px * MAX_DEG * 2}deg`)
            card.style.setProperty('--rx', `${-py * MAX_DEG * 2}deg`)
          })
          card.addEventListener('pointerleave', reset)
          card.addEventListener('blur', reset)
        })
      }
    </script>
  </body>
</html>
